# =============================================================================
# Backend Environment Variables — Copy this file to .env and fill in values
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
MONGO_URI=

# JWT secret for signing authentication tokens (use a long random string)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Google Gemini AI API key (https://aistudio.google.com/apikey)
GOOGLE_GENAI_API_KEY=

# Gemini model name
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated allowed origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
