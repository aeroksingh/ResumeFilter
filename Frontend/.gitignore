# =============================================================================
# Frontend .gitignore
# =============================================================================

# ---------- Dependencies ----------
node_modules/

# ---------- Environment Variables ----------
.env
.env.local
.env.*.local

# ---------- Build / Output ----------
dist/
dist-ssr/
build/

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- OS Files ----------
.DS_Store
Thumbs.db

# ---------- IDE / Editor ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Coverage & Testing ----------
coverage/

# ---------- Misc ----------
*.local
*.tgz
.cache/
