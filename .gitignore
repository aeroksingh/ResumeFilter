dist/
build/
out/

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- OS Files ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---------- IDE / Editor ----------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Coverage & Testing ----------
coverage/
.nyc_output/

# ---------- Misc ----------
*.tgz
.cache/
.temp/
.tmp/
